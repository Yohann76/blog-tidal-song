# Configuration Docker - Chant des Marées
# cp env.example .env (cp .env.example to .env)

# Domaine principal
DOMAIN=votre-domaine.com
WWW_DOMAIN=www.votre-domaine.com

# Email pour les certificats SSL
SSL_EMAIL=contact@votre-domaine.com

# Ports (développement)
HTTP_PORT=80
HTTPS_PORT=443

# Monitoring
ENABLE_MONITORING=true
MONITORING_PORT=9113

# Sauvegarde
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"  # Tous les jours à 2h

# Nginx
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024

# SSL/TLS
SSL_PROTOCOLS=TLSv1.2 TLSv1.3
SSL_CIPHERS=ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512

# Cache
CACHE_EXPIRES=1M
GZIP_COMPRESSION=6

# Sécurité
SECURITY_HEADERS=true
CSP_POLICY="default-src 'self' http: https: data: blob: 'unsafe-inline'"

# Logs
LOG_LEVEL=info
LOG_FORMAT=combined
